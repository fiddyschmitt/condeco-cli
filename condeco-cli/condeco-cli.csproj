<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>condeco_cli</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Single source of truth for the app version. Program.PROGRAM_VERSION reads this back from the
         assembly at runtime (banner, User-Agent, auto-update check). Bump here for each release. -->
    <Version>1.7.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommandLineParser" Version="2.9.1" />
    <PackageReference Include="Spectre.Console" Version="0.50.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\libCondeco\libCondeco.csproj" />
  </ItemGroup>

  <!-- Keep trimmed publishes working. CommandLineParser reflects over the options type, and
       Newtonsoft.Json (de)serialises the config and every API model; the trimmer can't see those
       reflective uses and strips the members (which broke arg parsing with "BaseOptions appears to be
       immutable, but no constructor found"). Rooting these assemblies preserves their members in full
       while the framework - the bulk of the size - is still trimmed. -->
  <ItemGroup Condition="'$(PublishTrimmed)' == 'true'">
    <TrimmerRootAssembly Include="condeco-cli" />
    <TrimmerRootAssembly Include="libCondeco" />
    <TrimmerRootAssembly Include="CommandLine" />
    <TrimmerRootAssembly Include="Newtonsoft.Json" />
    <TrimmerRootAssembly Include="Spectre.Console" />
  </ItemGroup>

</Project>
